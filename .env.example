# Network Attack Forecasting - Environment Variables
ENVIRONMENT=production
LOG_LEVEL=INFO

# Server Config
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis Streams Config (Local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_STREAM_KEY=network:telemetry:windows
REDIS_CONSUMER_GROUP=soc_inference_group

# SQLite Storage
DATABASE_PATH=data/predictions.db

# Hardware & Inference
DEVICE=cpu  # or cuda if GPU available
BATCH_SIZE=32
MAX_VRAM_MB=3500
